{erl_opts, [debug_info, {i, ["src", "include"]}]}.

{minimum_otp_vsn, "21"}.

{deps, []}.

{escript_incl_apps, [eee_lib]}.
{escript_name, esp_partition}.
{escript_comment, "ESP32 partition table generation tool"}.

{ex_doc, [
    {source_url, <<"https://github.com/UncleGrumpy/eee_tools">>},
    {homepage_url, <<"https://UncleGrumpy.github.io/eee_tools">>},
    {main, <<"esp_partition">>},
    {api_reference, true}
]}.

{cover_opts, [{verbose, true}, {cover_excl_mods, [esp_partition_cli]}]}.

{profiles, [
    {'ATOM', [
        {deps, [
            {eavmlib,
                {git_subdir, "https://github.com/atomvm/AtomVM", {branch, "main"}, "libs/eavmlib"}}
        ]},
        {plugins, [
            {atomvm_rebar3_plugin,
                {git, "https://github.com/atomvm/atomvm_rebar3_plugin", {branch, "master"}}}
        ]}
    ]},
    {test, [
        {deps, [
            % proper,
            {eavmlib,
                {git_subdir, "https://github.com/atomvm/AtomVM", {branch, "main"}, "libs/eavmlib"}}
        ]},
        {erl_opts, [
            debug_info,
            export_all,
            nowarn_sasl,
            nowarn_export_all,
            warnings_as_errors,
            {i, ["src", "include"]},
            {d, 'TEST', true}
        ]},
        {extra_src_dirs, ["test"]},

        {cover_enabled, true},
        {cover_opts, [verbose]},
        {cover_excl_mods, [esp_partition_cli]},
        {eunit_opts, [{cover, true}]},
        % {proper_opts, [
        %     {dir, "test"},
        %     {module, "esp_partition_prop"},
        %     {cover, true},
        %     {verbose, false}
        % ]},
        {dialyzer, [
            {plt_apps, all_deps},
            {plt_extra_apps, [proper, eunit, common_test]},
            {base_plt_prefix, "test"}
        ]},
        {xref_extra_paths, ["test", "apps/*/test"]},
        {xref_checks, [
            undefined_function_calls,
            undefined_functions,
            locals_not_used,
            deprecated_function_calls,
            deprecated_functions
        ]},
        {plugins, [
            % rebar3_proper,
            erlfmt
        ]}
    ]},
    {doc, [
        {plugins, [rebar3_ex_doc]},
        {hex, [
            {doc, #{provider => ex_doc}}
        ]}
    ]}
]}.
