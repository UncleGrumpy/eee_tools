{erl_opts, [debug_info, nowarn_sasl, {i, ["src", "include"]}]}.
{minimum_otp_vsn, "21"}.

% {escript_name, eee_tool}.
% {escript_incl_apps, [eee_lib]}.
% {escript_comment, "Swiss Army Knife for BEAM developers targeting micro-controllers"}.

{ex_doc, [
    {source_url, <<"https://github.com/UncleGrumpy/eee_tools">>},
    {main, <<"README.md">>},
    {api_reference, true}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{profiles, [
    {'ATOM', [
        {deps, [
            {eavmlib,
                {git_subdir, "https://github.com/atomvm/AtomVM", {branch, "main"}, "libs/eavmlib"}}
        ]},
        {plugins, [
            {atomvm_rebar3_plugin,
                {git, "https://github.com/atomvm/atomvm_rebar3_plugin", {branch, "master"}}}
        ]}
    ]},
    {test, [
        {erl_opts, [
            debug_info,
            export_all,
            nowarn_sasl,
            nowarn_export_all,
            warnings_as_errors,
            {i, ["src", "include"]},
            {d, 'TEST', true}
        ]},
        {extra_src_dirs, ["test"]},
        {cover_enabled, true},
        {cover_opts, [{verbose, true}, {cover_excl_mods, [eee_tools_app]}]},
        %     {proper_opts, [
        %         {dir, "test"},
        %         {module, "eee_tools_prop"},
        %         {cover, true},
        %         {verbose, false}
        %     ]},
        %     {deps, [
        %         proper
        %     ]},
        {plugins, [
            erlfmt
            %         rebar3_proper
        ]}
    ]},
    {doc, [
        {plugins, [rebar3_ex_doc]},
        {hex, [
            {doc, #{provider => ex_doc}}
        ]}
    ]}
]}.
