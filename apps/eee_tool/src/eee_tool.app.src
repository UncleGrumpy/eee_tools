{application, eee_tool, [
    {description, "A toolkit for working with ESP32 devices providing escripts and API libraries"},
    {vsn, "0.1.0"},
    {registered, []},
    {applications, [
        kernel,
        stdlib,
        eee_lib,
        esp_nvs,
        esp_partition
    ]},
    {env, []},
    {licenses, ["Apache-2.0", "LGPL-2.1-or-later"]},
    {maintainers, ["Winford"]},
    {links, [{"GitHub", "https://github.com/UncleGrumpy/eee_tools/"}]}
]}.
